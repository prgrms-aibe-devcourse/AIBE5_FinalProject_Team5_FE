# Backend API base URL for browser builds
VITE_API_BASE_URL=

# Google OAuth Client ID (Google Cloud Console에서 발급)
VITE_GOOGLE_CLIENT_ID=

# Google OAuth Client Secret (개발용. 배포 전에 프론트 노출 여부 재검토 필요)
VITE_GOOGLE_CLIENT_SECRET=

# Kakao OAuth REST API Key (Kakao Developers > 앱 > 플랫폼 키)
VITE_KAKAO_CLIENT_ID=
